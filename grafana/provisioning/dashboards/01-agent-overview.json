{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "AgentOps overview (paper 1 taxonomy: who is running, are they slow, are they failing). Per-agent rates derive from agentops_plan_steps_total — the only counter R13.1's agent code labels with `agent`. LLM-level metrics (latency, errors) are fleet-aggregate because the underlying counters carry only `model` + `outcome`.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    { "title": "Cost & Budget", "url": "/d/agentops-cost", "type": "link", "icon": "external link" },
    { "title": "Tool Calls",    "url": "/d/agentops-tools", "type": "link", "icon": "external link" },
    { "title": "Flow Discovery","url": "/d/agentops-flow",  "type": "link", "icon": "external link" }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active agents",
      "description": "Distinct values of the `agent` label on agentops_plan_steps_total seen in the last 5m.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "green", "value": 3 }
            ]
          },
          "unit": "none"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "count(count by (agent) (rate(agentops_plan_steps_total[5m]) > 0))",
          "legendFormat": "agents",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "LLM calls / minute",
      "description": "Fleet-wide LLM invocation rate (agentops_llm_invocations_total), last 5m, per minute.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "unit": "reqpm",
          "decimals": 1
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(rate(agentops_llm_invocations_total[5m])) * 60",
          "legendFormat": "calls/m",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "P95 LLM latency (5m)",
      "description": "95th-percentile LLM call duration across the fleet, from the agentops_llm_latency_ms histogram. Unit converted from ms to seconds for the display.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "s",
          "decimals": 2
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(agentops_llm_latency_ms_bucket[5m]))) / 1000",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "LLM error rate (5m)",
      "description": "Share of agentops_llm_invocations_total with outcome=error in the last 5m.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "percent",
          "decimals": 2
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "100 * sum(rate(agentops_llm_invocations_total{outcome=\"error\"}[5m])) / clamp_min(sum(rate(agentops_llm_invocations_total[5m])), 1e-9)",
          "legendFormat": "error %",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Plan-step rate per agent",
      "description": "Per-agent activity, derived from agentops_plan_steps_total{agent}.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "stacking": { "mode": "none", "group": "A" }
          },
          "unit": "ops"
        }
      },
      "options": {
        "legend": { "calcs": ["mean", "lastNotNull"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum by (agent) (rate(agentops_plan_steps_total[$__rate_interval]))",
          "legendFormat": "{{agent}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "P50 / P95 / P99 LLM latency (by model)",
      "description": "Three latency quantiles per LLM model. Per-agent breakdown isn't available because agentops_llm_latency_ms only carries the `model` label — flagged in recording-rules.md as a small instrumentation addition.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 0
          },
          "unit": "ms"
        }
      },
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (model, le) (rate(agentops_llm_latency_ms_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{model}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (model, le) (rate(agentops_llm_latency_ms_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{model}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (model, le) (rate(agentops_llm_latency_ms_bucket[$__rate_interval])))",
          "legendFormat": "p99 {{model}}",
          "refId": "C"
        }
      ]
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Tool failures by tool + error_type",
      "description": "agentops_tool_invocations_total{outcome=\"error\"} grouped by tool and error type. One row per (tool, error). Approximates the spec's 'failures by agent + error_type' — per-agent attribution isn't on the counter; correlate via the trace ID in the slow-traces table below if needed.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "yellow", "value": null },
              { "color": "orange", "value": 5 },
              { "color": "red", "value": 25 }
            ]
          },
          "unit": "short"
        }
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true,
        "valueMode": "color"
      },
      "targets": [
        {
          "expr": "sum by (tool, error) (increase(agentops_tool_invocations_total{outcome=\"error\"}[1h]))",
          "legendFormat": "{{tool}} / {{error}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Recent workload ticks (last 1h)",
      "description": "agentops.workload log lines containing tick + elapsed time. Slowest at the top. The TraceID column links to Jaeger when the log line carries a trace_id (it will once R13.1 enables the OTel log handler — currently OK, see instrumentation.py:94).",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "left", "displayMode": "auto" }
        },
        "overrides": []
      },
      "options": { "showHeader": true, "footer": { "show": false } },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{service_name=\"agent-fleet\"} |= \"tick=\" |= \"elapsed=\"",
          "queryType": "range",
          "refId": "A",
          "maxLines": 100
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["agentops", "overview", "paper-1"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "AgentOps - Agent Overview",
  "uid": "agentops-overview",
  "version": 1,
  "weekStart": ""
}
